@model WebCRUDMVCSQL.Models.Produto

@{
    ViewData["Title"] = "Deletar Produto";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-3 text-center text-danger">
                    <h3 class="fw-bold m-0">Excluir Produto</h3>
                    <p class="text-muted small mt-1">Deseja realmente remover este registro do sistema?</p>
                </div>
                
                <div class="alert alert-warning text-center py-2 small mb-4" role="alert">
                    ⚠️ Esta operação removerá permanentemente o item.
                </div>

                <div class="bg-light rounded-3 p-4 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Produto:</dt>
                        <dd class="col-sm-8 text-dark fw-medium mb-3">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Peso:</dt>
                        <dd class="col-sm-8 text-dark fw-medium mb-3">@Html.DisplayFor(model => model.Peso) kg</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-0">Preço:</dt>
                        <dd class="col-sm-8 text-dark fw-medium mb-0">R$ @Html.DisplayFor(model => model.Preco)</dd>
                    </dl>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="text-decoration-none fw-semibold text-muted">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 py-2 fw-bold shadow-sm">Confirmar Exclusão</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>