@model WebCRUDMVCSQL.Models.Produto

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark m-0">Ficha Técnica</h3>
                    <small class="text-muted">Informações detalhadas obtidas do banco</small>
                </div>
                <hr class="text-muted mb-4" />

                <div class="bg-light rounded-3 p-4 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Nome:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-3">@Html.DisplayFor(model => model.Nome)</dd>
                        
                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Peso:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-3">@Html.DisplayFor(model => model.Peso) kg</dd>
                        
                        <dt class="col-sm-4 text-secondary small fw-bold mb-0">Preço:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-0">R$ @Html.DisplayFor(model => model.Preco)</dd>
                    </dl>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">← Voltar</a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Editar Produto</a>
                </div>
            </div>
        </div>
    </div>
</div>