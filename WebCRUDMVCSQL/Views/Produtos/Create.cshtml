@model WebCRUDMVCSQL.Models.Produto

@{
    ViewData["Title"] = "Novo Produto";
}



<div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark m-0">Novo Produto</h3>
                    <small class="text-muted">Preencha as informações do item técnico abaixo</small>
                </div>
                <hr class="text-muted mb-4" />

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Nome" class="form-label small fw-semibold text-secondary">Nome do Produto</label>
                        <input asp-for="Nome" class="form-control px-3 py-2" placeholder="Nome comercial" required />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Peso" class="form-label small fw-semibold text-secondary">Peso (kg)</label>
                            <input asp-for="Peso" class="form-control px-3 py-2" placeholder="0.00" required />
                            <span asp-validation-for="Peso" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group mb-4">
                            <label asp-for="Preco" class="form-label small fw-semibold text-secondary">Preço (R$)</label>
                            <input asp-for="Preco" class="form-control px-3 py-2" type="text" placeholder="0,00" required />
                            <span asp-validation-for="Preco" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-action="Index" class="text-decoration-none fw-semibold text-muted">← Voltar para a Lista</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Salvar Registro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>



