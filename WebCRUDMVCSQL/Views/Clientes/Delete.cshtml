@model IEnumerable<WebCRUDMVCSQL.Models.Clientes>

@{
    ViewData["Title"] = "Clientes";
}

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        ⚠️ @TempData["Aviso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold m-0">Clientes</h3>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
        + Novo Cliente
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Nome</th>
                    <th>CPF</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th class="text-center">Status</th>
                    <th class="text-center pe-4">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr class="@(!cliente.Ativo ? "table-secondary text-muted" : "")">
                        <td class="ps-4 fw-medium">@cliente.Nome</td>
                        <td>@cliente.Cpf</td>
                        <td>@cliente.Email</td>
                        <td>@cliente.Telefone</td>

                        {{-- Toggle Ativo/Inativo --}}
                        <td class="text-center">
                            <form asp-action="AlterarStatus" asp-route-id="@cliente.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-sm fw-semibold px-3 @(cliente.Ativo ? "btn-success" : "btn-outline-secondary")"
                                        title="@(cliente.Ativo ? "Clique para desativar" : "Clique para reativar")">
                                    @if (cliente.Ativo)
                                    {
                                        <span>● Ativo</span>
                                    }
                                    else
                                    {
                                        <span>○ Inativo</span>
                                    }
                                </button>
                            </form>
                        </td>

                        <td class="text-center pe-4">
                            <a asp-action="Details" asp-route-id="@cliente.Id"
                               class="btn btn-sm btn-outline-info me-1" title="Detalhes">
                                🔍
                            </a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id"
                               class="btn btn-sm btn-outline-primary" title="Editar">
                                ✏️
                            </a>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Nenhum cliente cadastrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>