@model WebCRUDMVCSQL.Models.Clientes

@{
    ViewData["Title"] = "Deletar Cliente";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-3 text-center text-danger">
                    <h3 class="fw-bold m-0">Excluir Conta</h3>
                    <p class="text-muted small mt-1">Deseja remover este cliente permanentemente?</p>
                </div>
                
                <div class="alert alert-warning text-center py-2 small mb-4" role="alert">
                    ⚠️ Atenção: Esta ação não poderá ser desfeita após a confirmação.
                </div>

                <div class="bg-light rounded-3 p-4 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Nome:</dt>
                        <dd class="col-sm-8 text-dark fw-medium mb-3">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">CPF:</dt>
                        <dd class="col-sm-8 text-dark fw-medium mb-3">@Html.DisplayFor(model => model.Cpf)</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">E-mail:</dt>
                        <dd class="col-sm-8 text-dark fw-medium mb-3">@Html.DisplayFor(model => model.Email)</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-0">Endereço:</dt>
                        <dd class="col-sm-8 text-dark fw-medium mb-0">@Html.DisplayFor(model => model.Endereco)</dd>
                    </dl>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="text-decoration-none fw-semibold text-muted">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4 py-2 fw-bold shadow-sm">Confirmar Exclusão</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>