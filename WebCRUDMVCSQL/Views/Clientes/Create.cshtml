@model WebCRUDMVCSQL.Models.Clientes

@{
    ViewData["Title"] = "Novo Cliente";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark m-0">Novo Cliente</h3>
                    <small class="text-muted">Preencha os dados cadastrais do novo registro</small>
                </div>
                <hr class="text-muted mb-4" />

                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    
                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Nome" class="form-label small fw-semibold text-secondary">Nome Completo</label>
                            <input asp-for="Nome" class="form-control px-3 py-2" placeholder="Nome do cliente" />
                            <span asp-validation-for="Nome" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Cpf" class="form-label small fw-semibold text-secondary">CPF</label>
                            <input asp-for="Cpf" class="form-control px-3 py-2" placeholder="000.000.000-00" />
                            <span asp-validation-for="Cpf" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Telefone" class="form-label small fw-semibold text-secondary">Telefone / celular</label>
                            <input asp-for="Telefone" class="form-control px-3 py-2" type="text" placeholder="(00) 00000-0000" />
                            <span asp-validation-for="Telefone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="DataNascimento" class="form-label small fw-semibold text-secondary">Data de Nascimento</label>
                            <input asp-for="DataNascimento" class="form-control px-3 py-2" type="date" />
                            <span asp-validation-for="DataNascimento" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-secondary">E-mail Comercial</label>
                        <input asp-for="Email" class="form-control px-3 py-2" type="text" placeholder="nome@provedor.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Endereco" class="form-label small fw-semibold text-secondary">Endereço Residencial</label>
                        <input asp-for="Endereco" class="form-control px-3 py-2" type="text" placeholder="Rua, Número, Bairro, Cidade" />
                        <span asp-validation-for="Endereco" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-action="Index" class="text-decoration-none fw-semibold text-muted">← Voltar para a Lista</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Salvar Registro</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}