@model IEnumerable<WebCRUDMVCSQL.Models.Clientes>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="fw-bold text-dark m-0">Cadastro de Clientes</h2>
        <small class="text-muted">Gerencie a listagem e os contatos da sua empresa</small>
    </div>
    <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
        + Adicionar Cliente
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary">
                <tr>
                    <th class="ps-4 py-3">@Html.DisplayNameFor(model => model.Nome)</th>
                    <th class="py-3">@Html.DisplayNameFor(model => model.Cpf)</th>
                    <th class="py-3">@Html.DisplayNameFor(model => model.Telefone)</th>
                    <th class="py-3">@Html.DisplayNameFor(model => model.Email)</th>
                    <th class="py-3">@Html.DisplayNameFor(model => model.Endereco)</th>
                    <th class="py-3 text-end pe-4">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 fw-medium text-dark">@Html.DisplayFor(modelItem => item.Nome)</td>
                        <td class="py-3 text-secondary small">@Html.DisplayFor(modelItem => item.Cpf)</td>
                        <td class="py-3 text-secondary small">@Html.DisplayFor(modelItem => item.Telefone)</td>
                        <td class="py-3 text-secondary small">@Html.DisplayFor(modelItem => item.Email)</td>
                        <td class="py-3 text-secondary small">@Html.DisplayFor(modelItem => item.Endereco)</td>
                        <td class="py-3 text-end pe-4">
                            <div class="btn-group shadow-sm" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info px-3">Detalhes</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3">Deletar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>