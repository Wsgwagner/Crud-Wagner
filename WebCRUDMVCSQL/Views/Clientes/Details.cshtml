@model WebCRUDMVCSQL.Models.Clientes

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark m-0">Perfil do Cliente</h3>
                    <small class="text-muted">Informações salvas e indexadas no sistema</small>
                </div>
                <hr class="text-muted mb-4" />

                <div class="bg-light rounded-3 p-4 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Nome do Cliente:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-3">@Html.DisplayFor(model => model.Nome)</dd>
                        
                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">CPF:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-3">@Html.DisplayFor(model => model.Cpf)</dd>
                        
                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Telefone:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-3">@Html.DisplayFor(model => model.Telefone)</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">Nascimento:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-3">@Html.DisplayFor(model => model.DataNascimento)</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-3">E-mail:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-3">@Html.DisplayFor(model => model.Email)</dd>

                        <dt class="col-sm-4 text-secondary small fw-bold mb-0">Endereço:</dt>
                        <dd class="col-sm-8 text-dark fw-semibold mb-0">@Html.DisplayFor(model => model.Endereco)</dd>
                    </dl>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="text-decoration-none fw-semibold text-muted">← Voltar para a Lista</a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Editar Registro</a>
                </div>
            </div>
        </div>
    </div>
</div>