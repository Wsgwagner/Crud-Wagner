@model WebCRUDMVCSQL.Models.Pedidos

@{
    ViewData["Title"] = "Detalhes do Pedido";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark m-0">Ficha Técnica do Pedido #@Model.Id</h3>
                    <small class="text-muted">Dados gerais da venda e itens inclusos</small>
                </div>
                <hr class="text-muted mb-4" />

                <div class="bg-light rounded-3 p-4 mb-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-secondary small fw-bold mb-2">Cliente:</dt>
                        <dd class="col-sm-9 text-dark fw-semibold mb-2">@Model.Cliente?.Nome</dd>
                        
                        <dt class="col-sm-3 text-secondary small fw-bold mb-2">Data do Registro:</dt>
                        <dd class="col-sm-9 text-dark fw-medium mb-2">@Model.DataPedido.ToString("dd/MM/yyyy HH:mm")</dd>
                        
                        <dt class="col-sm-3 text-secondary small fw-bold mb-0">Valor Total:</dt>
                        <dd class="col-sm-9 text-success fw-bold mb-0">R$ @Model.Total.ToString("F2")</dd>
                    </dl>
                </div>

                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-cart-check"></i> Itens deste Pedido</h6>
                <div class="table-responsive border rounded-3 mb-4">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Produto</th>
                                <th class="text-center">Quantidade</th>
                                <th class="text-end pe-3">Preço Unitário</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Itens)
                            {
                                <tr>
                                    <td class="ps-3 fw-medium text-dark">@item.Produto?.Nome</td>
                                    <td class="text-center"><span class="badge bg-secondary px-2 py-1">@item.Quantidade</span></td>
                                    <td class="text-end pe-3 text-muted">R$ @item.PrecoUnitario.ToString("F2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-3">
                    <a asp-action="Index" class="text-decoration-none fw-semibold text-muted">← Voltar para a Lista</a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Editar Registro</a>
                </div>
            </div>
        </div>
    </div>
</div>