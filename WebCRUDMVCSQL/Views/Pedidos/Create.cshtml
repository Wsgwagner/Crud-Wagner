@model WebCRUDMVCSQL.Models.Pedidos

@{
    ViewData["Title"] = "Novo Pedido";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="row justify-content-center mt-3">
    <div class="col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark m-0">Novo Pedido</h3>
                    <small class="text-muted">Monte o carrinho de compras do cliente abaixo</small>
                </div>
                <hr class="text-muted mb-4" />

                <form asp-action="Create" method="post" id="formPedido">

                    <div class="form-group mb-4">
                        <label class="form-label small fw-semibold text-secondary">Cliente</label>
                        <select name="clienteId" class="form-select select-busca" required>
                            <option value="">-- Selecione o cliente --</option>
                            @foreach (var item in (SelectList)ViewBag.ClienteId)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <h6 class="fw-bold text-secondary mb-3">
                            <i class="bi bi-box-seam"></i> Adicionar Produtos
                        </h6>
                        <div class="row align-items-end">
                            <div class="col-md-6 mb-2 mb-md-0">
                                <label class="form-label small fw-semibold text-muted">Produto</label>
                                <select id="selectProduto" class="form-select select-busca">
                                    <option value="">-- Selecione o produto --</option>
                                    @foreach (var item in (SelectList)ViewBag.ProdutoId)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 mb-2 mb-md-0">
                                <label class="form-label small fw-semibold text-muted">Quantidade</label>
                                <input id="inputQuantidade" type="number" class="form-control" value="1" min="1" />
                            </div>
                            <div class="col-md-3">
                                <button type="button" id="btnAdicionar" class="btn btn-secondary w-100 fw-semibold">
                                    <i class="bi bi-plus-lg"></i> Inserir
                                </button>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-2">Produtos no Pedido</h6>
                    <div class="table-responsive border rounded-3 mb-4">
                        <table class="table table-hover align-middle mb-0" id="tabelaItens">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Produto</th>
                                    <th style="width: 20%;">Quantidade</th>
                                    <th class="text-end pe-3" style="width: 15%;">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="listaItens">
                                <tr id="linhaVazia">
                                    <td colspan="3" class="text-center text-muted py-4 small">
                                        Nenhum produto adicionado ao carrinho ainda.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">← Voltar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Salvar Pedido</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let itemIndex = 0;

        document.getElementById('btnAdicionar').addEventListener('click', function () {
            const selectProd = document.getElementById('selectProduto');
            const inputQtd = document.getElementById('inputQuantidade');

            const produtoId = selectProd.value;
            const produtoNome = selectProd.options[selectProd.selectedIndex].text;
            const quantidade = parseInt(inputQtd.value);

            if (!produtoId || quantidade < 1) {
                alert('Selecione um produto válido e informe a quantidade.');
                return;
            }

            const linhaVazia = document.getElementById('linhaVazia');
            if (linhaVazia) linhaVazia.remove();

            const novaLinha = document.createElement('tr');
            novaLinha.innerHTML = `
                <td class="ps-3">
                    <input type="hidden" name="itens[${itemIndex}].ProdutoId" value="${produtoId}" />
                    <span class="fw-semibold text-dark">${produtoNome}</span>
                </td>
                <td>
                    <input type="hidden" name="itens[${itemIndex}].Quantidade" value="${quantidade}" />
                    <span class="badge bg-secondary fs-6 px-2">${quantidade}</span>
                </td>
                <td class="text-end pe-3">
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removerItem(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            document.getElementById('listaItens').appendChild(novaLinha);
            itemIndex++;

            selectProd.value = '';
            inputQtd.value = '1';
        });

        function removerItem(botao) {
            botao.closest('tr').remove();

            const lista = document.getElementById('listaItens');
            if (lista.children.length === 0) {
                lista.innerHTML = `
                    <tr id="linhaVazia">
                        <td colspan="3" class="text-center text-muted py-4 small">
                            Nenhum produto adicionado ao carrinho ainda.
                        </td>
                    </tr>
                `;
                itemIndex = 0;
            }
        }
    </script>
}