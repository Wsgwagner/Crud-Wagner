@model IEnumerable<WebCRUDMVCSQL.Models.Pedidos>

@{
    ViewData["Title"] = "Pedidos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 mt-4">
    <div>
        <h2 class="fw-bold text-dark m-0 tracking-tight">Cadastro de Pedidos</h2>
        <p class="text-muted m-0 small">Gerencie o histórico de vendas e requisições do sistema</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-cart-plus-fill"></i> Novo Pedido
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4 py-3" style="width: 15%;">Nº Pedido</th>
                    <th class="py-3" style="width: 35%;">Cliente</th>
                    <th class="py-3" style="width: 20%;">Data do Pedido</th>
                    <th class="py-3" style="width: 15%;">Total</th>
                    <th class="py-3 text-end pe-4" style="width: 15%;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <i class="bi bi-receipt fs-2 d-block mb-2 text-secondary"></i>
                            Nenhum pedido registrado no sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 fw-bold text-secondary">
                                #@item.Id
                            </td>
                            
                            <td class="py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle d-flex align-items-center justify-content-center bg-secondary-subtle text-secondary rounded-3" style="width: 38px; height: 38px;">
                                        <i class="bi bi-person fs-5"></i>
                                    </div>
                                    <div>
                                        <span class="fw-semibold text-dark d-block">@item.Cliente?.Nome</span>
                                    </div>
                                </div>
                            </td>
                            
                            <td class="py-3 text-muted">
                                @item.DataPedido.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            
                            <td class="py-3 fw-bold text-success">
                                R$ @item.Total.ToString("F2")
                            </td>
                            
                            <td class="py-3 text-end pe-4">
                                <div class="d-inline-flex gap-1" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary border shadow-sm px-2" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light text-info border shadow-sm px-2" title="Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger border shadow-sm px-2" title="Deletar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>