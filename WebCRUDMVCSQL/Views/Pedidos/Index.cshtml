@model IEnumerable<WebCRUDMVCSQL.Models.Pedidos>

@{
    ViewData["Title"] = "Pedidos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        ⚠️ @TempData["Aviso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold m-0">Pedidos</h3>
    <a asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
        + Novo Pedido
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Nº Pedido</th>
                    <th>Cliente</th>
                    <th>Data</th>
                    <th>Total</th>
                    <th class="text-center pe-4">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-secondary">#@item.Id</td>
                        <td class="fw-medium">@item.Cliente?.Nome</td>
                        <td class="text-muted">@item.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="fw-bold text-success">@item.Total.ToString("C2")</td>
                        <td class="text-center pe-4">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info me-1" title="Detalhes">
                                🔍
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary me-1" title="Editar">
                                ✏️
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    title="Excluir"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalDelete"
                                    data-id="@item.Id"
                                    data-numero="@item.Id"
                                    data-cliente="@item.Cliente?.Nome">
                                🗑️
                            </button>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            Nenhum pedido registrado.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Modal de confirmação de exclusão *@
<div class="modal fade" id="modalDelete" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-danger">Excluir Pedido</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-muted">
                Deseja realmente excluir o pedido <strong id="numeroPedido"></strong> do cliente <strong id="nomeCliente"></strong>?
                <div class="alert alert-warning small mt-3 mb-0">
                    ⚠️ Todos os itens do pedido serão removidos permanentemente.
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formDelete" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger fw-semibold">Confirmar Exclusão</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalDelete').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            const id = btn.getAttribute('data-id');
            const numero = btn.getAttribute('data-numero');
            const cliente = btn.getAttribute('data-cliente');

            document.getElementById('numeroPedido').textContent = '#' + numero;
            document.getElementById('nomeCliente').textContent = cliente;
            document.getElementById('formDelete').action = '/Pedidos/Delete/' + id;
        });
    </script>
}