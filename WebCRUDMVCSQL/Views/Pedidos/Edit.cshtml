@model WebCRUDMVCSQL.Models.Pedidos

@{
    ViewData["Title"] = "Editar Pedido";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3 p-4">
            <div class="card-body">
                <div class="mb-4">
                    <h3 class="fw-bold text-dark m-0">Editar Pedido #@Model.Id</h3>
                    <small class="text-muted">Modifique os itens do carrinho e salve as alterações</small>
                </div>
                <hr class="text-muted mb-4" />

                <form asp-action="Edit" method="post" id="formPedido">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-4">
                        <label class="form-label small fw-semibold text-secondary">Nome do Cliente</label>
                        <select name="clienteId" class="form-select select-busca px-3 py-2" asp-items="ViewBag.ClienteId" required></select>
                    </div>

                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-box-seam"></i> Inserir Novos Produtos</h6>
                        <div class="row align-items-end">
                            <div class="col-md-6 mb-2 mb-md-0">
                                <label class="form-label small fw-semibold text-muted">Produto</label>
                                <select id="selectProduto" class="form-select select-busca" asp-items="ViewBag.ProdutoId">
                                    <option value="">-- Digite para buscar o produto --</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-2 mb-md-0">
                                <label class="form-label small fw-semibold text-muted">Quantidade</label>
                                <input id="inputQuantidade" type="number" class="form-control" value="1" min="1" />
                            </div>
                            <div class="col-md-3">
                                <button type="button" id="btnAdicionar" class="btn btn-secondary w-100 fw-semibold">
                                    <i class="bi bi-plus-lg"></i> Inserir
                                </button>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-2">Produtos no Pedido</h6>
                    <div class="table-responsive border rounded-3 mb-4">
                        <table class="table table-hover align-middle mb-0" id="tabelaItens">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Produto</th>
                                    <th style="width: 20%;">Quantidade</th>
                                    <th class="text-end pe-3" style="width: 15%;">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="listaItens">
                                @{
                                    int index = 0;
                                }
                                @foreach (var item in Model.Itens)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <input type="hidden" name="itens[@index].ProdutoId" value="@item.ProdutoId" />
                                            <span class="fw-semibold text-dark">@item.Produto?.Nome</span>
                                        </td>
                                        <td>
                                            <input type="hidden" name="itens[@index].Quantidade" value="@item.Quantidade" />
                                            <span class="badge bg-secondary px-2.5 py-1.5 fs-6">@item.Quantidade</span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removerItem(this)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">← Voltar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm">Salvar Alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let itemIndex = @Model.Itens.Count;

        // Inicializa o Select2 nos campos com a classe 'select-busca'
        $(document).ready(function() {
            $('.select-busca').select2({
                theme: 'bootstrap-5',
                width: '100%'
            });
        });

        document.getElementById('btnAdicionar').addEventListener('click', function () {
            const selectProd = document.getElementById('selectProduto');
            const inputQtd = document.getElementById('inputQuantidade');
            
            const produtoId = selectProd.value;
            const produtoNome = selectProd.options[selectProd.selectedIndex].text;
            const @Html.Raw("quantidade") = inputQtd.value;

            if (!produtoId || @Html.Raw("quantidade") < 1) {
                alert('Selecione um produto válido e a quantidade correta.');
                return;
            }

            const novaLinha = document.createElement('tr');
            novaLinha.innerHTML = `
                <td class="ps-3">
                    <input type="hidden" name="itens[${itemIndex}].ProdutoId" value="${produtoId}" />
                    <span class="fw-semibold text-dark">${produtoNome}</span>
                </td>
                <td>
                    <input type="hidden" name="itens[${itemIndex}].Quantidade" value="${@Html.Raw("quantidade")}" />
                    <span class="badge bg-secondary px-2.5 py-1.5 fs-6">${@Html.Raw("quantidade")}</span>
                </td>
                <td class="text-end pe-3">
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removerItem(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            document.getElementById('listaItens').appendChild(novaLinha);
            itemIndex++;

            // Correção para resetar o Select2 dinamicamente
            $('#selectProduto').val('').trigger('change');
            inputQtd.value = '1';
        });

        function removerItem(botao) {
            botao.closest('tr').remove();
            
            const lista = document.getElementById('listaItens');
            if (lista.children.length === 0) {
                itemIndex = 0;
            }
        }
    </script>
}